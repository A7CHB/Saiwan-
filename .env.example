# --- Database -------------------------------------------------------------
# SQLite by default (zero-config). Swap provider in prisma/schema.prisma to
# "postgresql" and point this at a Postgres URL for production.
DATABASE_URL="file:./dev.db"

# --- Auth -----------------------------------------------------------------
# 32+ char random string. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Bootstrap admin ------------------------------------------------------
# Used only by `npm run db:seed` to create the first administrator.
ADMIN_EMAIL="admin@saiwan.com"
ADMIN_PASSWORD="ChangeMe!2024"

# --- Brand ----------------------------------------------------------------
# International format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER="9647500000000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
