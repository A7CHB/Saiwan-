# --- Database -------------------------------------------------------------
# Postgres. Any provider works — Neon (what DEPLOY.md walks through), Vercel
# Postgres, Railway, or one on your own machine.
#
# Use the *pooled* connection string on serverless hosting: every request can
# start its own instance, and a direct connection per instance exhausts the
# database's connection limit under any real traffic. Neon's pooled host has
# "-pooler" in it.
DATABASE_URL="postgresql://user:password@host/saiwan?sslmode=require"

# --- Auth -----------------------------------------------------------------
# 32+ char random string. Generate: openssl rand -base64 48
# Changing this signs every dashboard user out.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Bootstrap admin ------------------------------------------------------
# Used only when seeding an empty database, to create the first administrator.
# Set these before the first deploy — afterwards they are ignored, and the
# password can only be changed from the dashboard.
ADMIN_EMAIL="admin@saiwan.com"
ADMIN_PASSWORD="ChangeMe!2024"

# --- Brand ----------------------------------------------------------------
# International format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER="9647500000000"
# The site's own address. Used for canonical URLs, sitemap and share cards, so
# it must be the real domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
